```gitignore
# Dependencies
node_modules/

# Build artifacts
dist/
build/
target/

# Environment variables
.env
.env.local
*.env.*

# Editor/IDE files
.vscode/
.idea/
*.swp
*.swo
*.tmp

# Logs
*.log

.svelte-kit/
.next/

# Coverage reports
coverage/
htmlcov/
.coverage

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd

# TypeScript/JavaScript cache
*.tsbuildinfo
.nyc_output/

# Package lock files
package-lock.json

# System files
.DS_Store
Thumbs.db

# Tauri
**/tauri**

# Tauri / Rust build artifacts
src-tauri/target/
src-tauri/binaries/

# Vite
.vite/

# PostCSS
.postcss-cache/

# Testing
coverage/
.nyc_output/
istanbul/

.Python
*.so
.coverage
htmlcov/
.coverage.*
.python-version

# Node.js
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Compiled files
*.o
*.obj
*.exe
*.dll
*.so
*.a
*.out

# TypeScript
tsconfig.tsbuildinfo
```